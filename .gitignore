# deps / build
node_modules/
dist/
.next/
.turbo/
*.tsbuildinfo

# secrets
.env
.env.*
!.env.example

# agent tooling (installed skills, symlinks)
.agents/
.claude/*
skills-lock.json

# ...but project skills we author are a shared artifact, not personal tooling, so they are
# tracked. Every directory on the path has to be re-included: git will not descend into an
# excluded directory to find a negation inside it.
!.claude/skills/
.claude/skills/*
!.claude/skills/wapi-nextjs/

# Mirrored WasenderAPI documentation — their copyrighted prose.
# Kept locally for reference and contract generation; never published.
# See PLAN.md §0 "Copyright".
docs/wasenderapi/raw/
docs/wasenderapi/llms.txt
docs/wasenderapi/reference/
docs/wasenderapi/structured/
docs/wasenderapi/INDEX.md
docs/wasenderapi/manifest.json


# gateway scratch auth state (phase 1a only)
apps/gateway/.auth-scratch/
.redis-external

# Windows reserved device name. Some tool in the toolchain redirects to `nul` as if it were a
# path, which creates a file git cannot index — `git add -A` then dies with "short read while
# indexing nul" and the commit fails silently while a deploy carries on shipping old code.
# That has happened three times; ignoring it is cheaper than rediscovering it a fourth.
nul

# Python bytecode caches. The Python SDK ships source only; these are per-interpreter build
# artifacts that differ between machines and would churn every diff.
__pycache__/
*.py[cod]

# Generated by fumadocs-mdx at build time from content/docs.
apps/web/.source/
