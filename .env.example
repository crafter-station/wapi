# Postgres — Dokploy-managed, local to the VPS (PLAN.md §7).
# Local dev uses the external port; the deployed services use the internal appName host.
DATABASE_URL=postgresql://user:pass@host:5432/wapi-db

# Redis — rate limits, gateway pub/sub, BullMQ.
REDIS_URL=redis://:pass@host:6379

# UploadX (PLAN.md §7). Hosted mode; set MINIO_* instead to bypass the dashboard.
UPLOADX_TOKEN=upx_live_xxx
UPLOADX_URL=https://uploadx.crafter.run

# Clerk — dashboard auth only. Machine credentials are hashed in Postgres (PLAN.md §3).
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

ENCRYPTION_KEY=  # 32 bytes hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
